# Copia este archivo a .env.local y ajusta los valores. Nunca commitees el .env.local real.

# URL base del backend (ver /backend). En Next.js, sólo las variables con
# prefijo NEXT_PUBLIC_ llegan al código que corre en el navegador.
NEXT_PUBLIC_API_URL="http://localhost:3000/api"

# El mismo Web Client ID que GOOGLE_CLIENT_ID en backend/.env y
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID en la app móvil.
NEXT_PUBLIC_GOOGLE_CLIENT_ID="your-google-web-client-id.apps.googleusercontent.com"

# Panel de administración (proyecto Vite aparte, ver /admin)
NEXT_PUBLIC_ADMIN_URL="http://localhost:5173"
