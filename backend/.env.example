# Copia este archivo a .env y ajusta los valores. Nunca commitees el .env real.

# Postgres local (ver docker-compose.yml en la raíz de /backend)
DATABASE_URL="postgresql://peyma:peyma@localhost:5432/peyma_music?schema=public"

PORT=3000
NODE_ENV=development

# Genera uno propio: `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET="replace-this-with-a-random-64-char-secret-before-deploying"

# Web Client ID de Google Cloud Console (el mismo que configura
# @react-native-google-signin/google-signin como `webClientId` en el
# cliente) — se usa sólo para verificar la audiencia del id_token, no hay
# client secret ni redirect URI porque no hay intercambio de código.
GOOGLE_CLIENT_ID="your-google-web-client-id.apps.googleusercontent.com"

# Orígenes permitidos por CORS, separados por coma. En dev: Expo web (8081),
# el túnel de Expo Go (19006), la app Next.js en /web (3001) y el panel
# admin en /admin (5173, Vite).
CORS_ORIGINS="http://localhost:8081,http://localhost:19006,http://localhost:3001,http://localhost:5173"

# Conexión DIRECTA a Postgres (sin pooler). Sólo la usa el CLI de Prisma para
# migraciones: los advisory locks de `migrate` son de sesión y no sobreviven a
# un pooler de transacciones. En Neon es la misma URL que DATABASE_URL pero
# quitando "-pooler" del host.
DIRECT_URL=postgresql://usuario:contraseña@host.neon.tech/basededatos?sslmode=require

# ---------------------------------------------------------------------------
# Almacenamiento de archivos (Cloudflare R2 / Amazon S3)
# ---------------------------------------------------------------------------
# Sin estas variables el backend guarda las subidas en ./uploads, que sirve
# para desarrollo. En producción sobre contenedores (Render, Fly, Railway…)
# el disco es EFÍMERO: cada despliegue arranca un contenedor nuevo y vacío,
# así que las canciones y portadas de los artistas se perderían mientras sus
# filas en Postgres seguirían apuntando a ellas — el catálogo se vería entero
# y nada sonaría. Con estas tres definidas, todo va al bucket.
#
# R2 (recomendado: no cobra por descarga, que es el grueso en streaming):
#   S3_ENDPOINT="https://<id-de-cuenta>.r2.cloudflarestorage.com"
#   S3_REGION="auto"
#
# CUIDADO CON LA JURISDICCIÓN. R2 permite crear un bucket con jurisdicción
# (EU, FedRAMP) y el nombre NO es único entre jurisdicciones: puedes tener
# dos buckets llamados igual y son distintos, con contenido distinto y su
# propio dominio público. Se eligen por el endpoint:
#
#   https://<cuenta>.r2.cloudflarestorage.com      -> jurisdicción por defecto
#   https://<cuenta>.eu.r2.cloudflarestorage.com   -> jurisdicción europea
#
# Confundirlos no da ningún error: se sube al bucket A, se sirve desde el
# dominio público del bucket B, y todo responde 404. Si S3_PUBLIC_BASE_URL
# lleva ".eu.", el endpoint también tiene que llevarlo.
# S3 de AWS: deja S3_ENDPOINT vacío y pon la región real (ej. "eu-west-1").
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_ENDPOINT=""
S3_REGION="auto"

# Dominio público desde el que se LEEN los archivos. En R2 es el dominio
# público del bucket o tu dominio propio conectado al CDN. Si se deja vacío
# se deduce del endpoint, que funciona pero expone la URL interna del bucket.
S3_PUBLIC_BASE_URL=""
