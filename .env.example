# Copia este archivo a .env y ajusta los valores. Nunca commitees el .env real.

# URL base del backend (ver /backend). En un dispositivo físico o simulador,
# "localhost" no apunta a tu máquina — usa la IP de tu red local
# (p. ej. http://192.168.1.5:3000/api) o el túnel de Expo.
EXPO_PUBLIC_API_URL="http://localhost:3000/api"

# El mismo Web Client ID que GOOGLE_CLIENT_ID en backend/.env — google-signin
# lo usa como `webClientId` para que el id_token traiga la audiencia correcta.
# Requiere un development build (no funciona en Expo Go).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID="your-google-web-client-id.apps.googleusercontent.com"
